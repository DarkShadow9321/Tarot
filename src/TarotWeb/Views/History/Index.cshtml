@model IReadOnlyList<TarotReading>
@{ ViewData["Title"] = "歷史紀錄"; }
<section class="section-heading"><span class="eyebrow">✧ READING JOURNAL</span><h1>每一段提問，都值得記住</h1><p>最近 100 筆占卜紀錄，資料由 SQL Server 讀取。</p></section>
@if (Model.Count == 0) { <div class="panel empty"><h2>還沒有占卜紀錄</h2><a asp-controller="Tarot" asp-action="Draw" class="btn primary">開始第一次占卜</a></div> }
else
{
    <div class="history-list">
    @foreach (var reading in Model)
    {
        <article class="history-item"><div><small>#@reading.Id · @reading.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm") · @reading.DrawCount 張牌</small><h2>@reading.Question</h2></div>
        <div class="history-actions"><a class="btn outline small" asp-controller="Tarot" asp-action="Result" asp-route-id="@reading.Id">查看</a>
        <form asp-action="Delete" method="post" data-confirm="確定刪除此筆占卜紀錄？"><input type="hidden" name="id" value="@reading.Id" /><button type="submit" class="btn danger small">刪除</button></form></div></article>
    }
    </div>
}
