<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · 星象塔羅</title>
    <link rel="stylesheet" asp-append-version="true" href="~/css/site.css" />
</head>
<body>
    <header class="site-header"><div class="container nav-wrap">
        <a class="brand" asp-controller="Home" asp-action="Index">✧ 星象塔羅 <small>TAROT STUDIO</small></a>
        <nav aria-label="主選單">
            <a asp-controller="Tarot" asp-action="Draw">開始占卜</a>
            <a asp-controller="History" asp-action="Index">歷史紀錄</a>
            <a asp-controller="CardsAdmin" asp-action="Index">牌卡管理</a>
        </nav>
    </div></header>
    <main class="container page">
        @if (TempData["Notice"] is string notice) { <div class="notice" role="status">@notice</div> }
        @RenderBody()
    </main>
    <footer class="site-footer container">✧ 練習作品 · ASP.NET Core MVC + SQL Server · 塔羅解讀僅供自我探索與娛樂參考</footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
